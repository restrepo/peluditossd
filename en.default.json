  "peluditos_volunteer": {
    "program": {
      "p3": "To look after our furry friends properly, we make sure every animal is medicated, fed a balanced diet of natural homemade food prepared by our own team, and sterilized — because we know how much sterilization protects the well-being of this generation and the ones that come after.",
      "p2": "When we welcome an unwanted animal through our gates, our aim is simple: restore their health — mental and physical — so they can be rehomed with people capable of giving them the love and attention they deserve.",
      "commit_desc": "is our minimum stay — we're not able to accept short-term volunteers right now. We'd love for you to consider committing for 6 months or more. Please only apply if you can commit to at least the 8-week minimum.",
      "p1": "We're a non-profit dedicated to caring for and protecting the many dogs and cats who arrive here as victims of neglect, abuse and abandonment.",
      "p4": "We're a small team, and every one of us is a dedicated animal lover, glad to share what we know with anyone who's interested. :)",
      "commit_heading": "We're looking for long-term volunteers",
      "commit_tag": "Please read before applying",
      "heading": "What we're building here",
      "eyebrow": "Program details",
      "commit_number": "8 weeks"
    },
    "experience": {
      "p1": "Our non-profit cares for rescued dogs, cats and horses — restoring their health so they can be rehomed with people who will love them. We feed <strong>natural, homemade food</strong> and sterilize every animal that comes through our gates.",
      "p2": "Our small team welcomes volunteers who want to help and learn. Working with us means sharing your days with animals who show love in return — and we'll always warmly welcome you into our sanctuary. :)",
      "p3": "The sanctuary itself is a paradise: tucked deep in the mountains, surrounded by streams, beautiful landscapes, and a quiet you won't find anywhere else.",
      "image_alt": "Volunteers caring for rescued animals at Peluditos SD Foundation",
      "file_comment_2": "(Shopify Admin -> Content -> Files). Upload your photo there",
      "file_comment_1": "Pulls \"the-experience.jpg\" from your Shopify Files library",
      "file_comment_3": "with exactly this filename, or edit the filename below to",
      "file_comment_4": "match whatever you named it after uploading.",
      "heading": "A sanctuary hidden in the mountains",
      "eyebrow": "The Experience"
    },
    "form": {
      "consent_required": "By checking this box, I agree to receive informational messages from Peluditos SD Foundation via email. I also confirm that I have read and agree to the <a href=\"#\">Privacy Policy</a> and <a href=\"#\">Terms &amp; Conditions</a>.",
      "consent_updates": "<strong>Get updates:</strong> by checking this box, I agree to receive the monthly newsletter and occasional updates. I can unsubscribe at any time. (optional)",
      "consent_sms": "I consent to receive messages via SMS / WhatsApp about my application. I understand I can opt out at any time by replying STOP. (optional)",
      "referral_placeholder": "How did you hear about us?",
      "country_placeholder": "Country of Residence*",
      "comments_placeholder": "Questions / Comments",
      "submit": "Submit application",
      "referral_site": "Volunteer website",
