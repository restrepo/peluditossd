      "last_name": "Last Name*",
      "required_note": "* Required",
      "country_de": "Germany",
      "email": "Email*",
      "option_other": "Other"
    },
    "closing": {
      "subtext": "Fill out the form below and our team will reach out with everything you need to know to apply — including next steps for the 8-week minimum stay.",
      "success_message": "Thanks — your application has been received. We'll be in touch soon!",
      "heading": "Ready to spend your days with the furry ones?"
    },
    "day": {
      "footnote": "With so many animals, the unexpected can always happen — occasionally work is needed after 5pm too. Flexibility is part of life here.",
      "lead": "The rhythm of the day follows the animals — busy at feeding times, quiet in between, with room to breathe after 5pm.",
      "slot3_desc": "Nursing tasks (wound treatment, etc.) + cleaning cat & dog dormitories",
      "slot1_desc": "Feed animals + clean common areas",
      "heading": "A day in the sanctuary",
      "eyebrow": "Activities & shift",
      "slot5_desc": "Feed animals",
      "slot4_desc": "Lunch break",
      "slot6_time": "After 17:00",
      "slot2_desc": "Breakfast",
      "slot6_desc": "Free time"
    },
    "offer": {
      "subtext": "Your time is split across a few essential jobs that keep the sanctuary — and the animals in it — running well.",
      "role3_desc": "Help look after and care for the dogs, cats and horses — feeding, nursing and simply spending time with them.",
      "role1_desc": "Help keep the kitchen, bedrooms, bathrooms and common areas clean and welcoming for everyone on site.",
      "role2_desc": "Help prepare, finish and serve the homemade meals — for the team and the animals alike.",
      "role4_desc": "Help with volunteer work in local projects and communities beyond the sanctuary gates.",
      "heading": "Where volunteers pitch in",
      "hours_badge": "hours of help per week",
      "eyebrow": "What you offer",
      "role2_title": "Kitchen hand",
      "role3_title": "Animal care",
      "role4_title": "Social work",
      "role1_title": "Cleaning"
    },
    "seeking": {
      "subtext": "If that's your background, we'd love to hear from you — but there are some skills we are also looking for:",
      "heading": "Right now, we're especially looking for veterinary assistants or dog trainers.",
      "skill2": "Someone to manage our social media (make posts or stories).",
      "skill1": "People with gardening and crop cultivation experience.",
      "cta": "I want to volunteer"
    },
    "get": {
      "item8_desc": "We happily welcome solo volunteers, couples, and volunteering partners.",
      "item5_desc": "Free use of the kitchen — cook your own food whenever you like.",
      "item2_desc": "Comfortable accommodation on site for the length of your stay.",
      "item6_desc": "A certificate of completion once your experience with us ends.",
