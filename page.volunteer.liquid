    {% endform %}
  </div>
</section>


</div>
<script>
  (function(){
    var el = document.querySelector('.peluditos-volunteer');
    if (!el) return;
    function fullBleed(){
      // Reset first so we measure the element's true, un-shifted offset
      el.style.marginLeft = '0px';
      el.style.marginRight = '0px';
      el.style.width = '';
      var rect = el.getBoundingClientRect();
      el.style.width = Math.ceil(window.innerWidth) + 'px';
      el.style.marginLeft = (-rect.left) + 'px';
      el.style.marginRight = 'auto';
      el.style.visibility = 'visible';
    }
    fullBleed();
    window.addEventListener('resize', fullBleed);
    // Re-run once more after fonts/images settle, in case the initial
    // measurement happened before the theme's own layout finished.
    window.addEventListener('load', fullBleed);
    // Safety net: if anything above throws, never leave the section hidden.
    setTimeout(function(){ el.style.visibility = 'visible'; }, 1500);
  })();
</script>
