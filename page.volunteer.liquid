<script>
(function(){
  // ---- FAQ accordion ----
  document.querySelectorAll('.pv2 .faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.faq-item');
      var wasOpen = item.classList.contains('open');
      item.closest('.faq-list').querySelectorAll('.faq-item').forEach(function(i){
        i.classList.remove('open');
      });
      if (!wasOpen) item.classList.add('open');
    });
  });

  // ---- Filter tabs ----
  var tabs = document.querySelectorAll('.pv2 .filter-tab');
  var cards = document.querySelectorAll('.pv2 .way-card');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.remove('active'); });
      tab.classList.add('active');
      var filter = tab.getAttribute('data-filter');
      cards.forEach(function(card){
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.hidden = false;
        } else {
          card.hidden = true;
        }
      });
    });
  });

  // ---- "Postularme" buttons pre-select the matching area in the form ----
  document.querySelectorAll('.pv2 .way-card-footer .btn[data-area]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var areaIndex = parseInt(btn.getAttribute('data-area'), 10);
      var select = document.querySelector('.pv2 select[name="contact[Area of Interest]"]');
      if (select && select.options[areaIndex]) {
        select.selectedIndex = areaIndex;
      }
    });
  });
})();

</script>
<script>
  (function(){
    var el = document.querySelector('.pv2');
    if (!el) return;
    function fullBleed(){
      el.style.marginLeft = '0px';
      el.style.marginRight = '0px';
      el.style.width = '';
      var rect = el.getBoundingClientRect();
      el.style.width = Math.ceil(window.innerWidth) + 'px';
      el.style.marginLeft = (-rect.left) + 'px';
      el.style.marginRight = 'auto';
      el.style.visibility = 'visible';
    }
    fullBleed();
    window.addEventListener('resize', fullBleed);
    window.addEventListener('load', fullBleed);
    setTimeout(function(){ el.style.visibility = 'visible'; }, 1500);
  })();
</script>
