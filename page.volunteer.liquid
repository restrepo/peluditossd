{% comment %}
  Fundacion Peluditos SD -- Volunteer Program page, ALTERNATE DESIGN #2.
  Custom page template for Shopify -- LOCALIZED VERSION.

  This is a second, alternate-design volunteer page living alongside the
  original templates/page.volunteer.liquid. It does not replace it --
  both can exist at the same time under different Shopify Pages, so you
  can compare or A/B test them before deciding which one to publish.

  Typography and colors match the original volunteer page: Montserrat
  throughout (weight 900 for all headings, 18px/1.4 body text), and
  the same four color tokens (navy #0F2742, cream #F0ECD3,
  orange #E8822F, paper #FFFDF7), no additional hues.

  FORM: this page now uses Shopify's built-in {% form 'contact' %},
  same mechanism as the original volunteer page, so submissions arrive
  at Settings -> Notifications -> "Contact form" email -- no app,
  no external service, no client-side WhatsApp link. It includes every
  field the original page's form has (name, email, phone, country,
  referral source, comments, consent checkboxes) PLUS a new required
  "Area of Interest" field (contact[Area of Interest]) matching the
  three volunteer areas described on this page. Clicking a card's
  "Postularme" button pre-selects that area in the form.

  All visitor-facing copy is pulled from Shopify's locale files via the
  {{ 'key' | t }} filter, under the "peluditos_volunteer2" namespace
  (kept separate from the original page's "peluditos_volunteer"
  namespace so the two pages' translations never collide).

  SETUP:
  1. Save this file as: templates/page.volunteer2.liquid
  2. Merge the "peluditos_volunteer2" key into your theme's
     locales/en.default.json and locales/es.json -- see the full,
     already-merged versions of both files provided alongside this one.
  3. In Settings -> Languages, make sure Spanish is a published
     language for your store, same as for the original volunteer page.
  4. In Shopify Admin -> Online Store -> Pages, create a new page
     (e.g. "Volunteers v2" / "Voluntarios v2") and set its Theme
     template to "page.volunteer2".
  5. Add the Google Fonts link (Montserrat) to your theme's
     layout/theme.liquid, inside <head>...</head>, once -- skip if
     your theme already loads it (the original volunteer page does):
     <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
     <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  FULL-WIDTH: uses the same runtime-measured full-bleed technique as
  the original page.volunteer.liquid.
{% endcomment %}

<style>
:root{
  --navy: #0F2742;
  --navy-2: #233a67;
  --navy-3: #0f1830;
  --cream: #F0ECD3;
  --cream-soft: #FAF8EE;
  --paper: #FFFDF7;
  --ink: #0F2742;
  --ink-soft: rgba(15,39,66,0.68);
  --ink-faint: rgba(15,39,66,0.48);
  --border: rgba(15,39,66,0.14);
  --dark: var(--navy);
  --dark-2: var(--navy-2);
  --orange: #E8822F;
  --orange-2: #C96A1E;
  --orange-soft: rgba(232,130,47,0.14);
  --orange-border: rgba(232,130,47,0.35);
  --shadow-card: 0 1px 2px rgba(15,39,66,0.05), 0 8px 24px -12px rgba(15,39,66,0.14);
  --shadow-lift: 0 20px 50px -20px rgba(15,39,66,0.35);
  --radius-lg: 24px;
  --radius-md: 16px;
  --radius-sm: 10px;
}
*{box-sizing:border-box; margin:0; padding:0;}
.pv2{
  font-family:'Montserrat', sans-serif;
  color:var(--ink);
  background:var(--cream);
  font-size:18px;
  line-height:1.4;
  -webkit-font-smoothing:antialiased;
}
.pv2 h1,.pv2 h2,.pv2 h3,.pv2 h4{
  font-family:'Montserrat', sans-serif;
  font-weight:900;
  line-height:1.4;
}
.pv2 em{font-style:normal; color:var(--orange); font-family:inherit; font-weight:inherit;}
.pv2 a{color:inherit; text-decoration:none;}
.pv2 img,.pv2 svg{display:block; max-width:100%;}
.pv2 .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}
.pv2 button{font-family:inherit; cursor:pointer;}

/* -------- pills / badges -------- */
.pv2 .pill{
  display:inline-flex; align-items:center; gap:8px;
  padding:8px 16px; border-radius:100px; font-size:12.5px; font-weight:700;
  letter-spacing:.06em; text-transform:uppercase;
}
.pv2 .pill-dark{background:var(--navy); color:var(--cream-soft);}
.pv2 .pill-outline{background:transparent; border:1.5px solid var(--border); color:var(--ink);}
.pv2 .pill-light{background:var(--paper); color:var(--ink-soft); border:1px solid var(--border);}

/* -------- buttons -------- */
.pv2 .btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:14px 26px; border-radius:100px; font-weight:700; font-size:14.5px;
  border:1.5px solid transparent; transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
}
.pv2 .btn:hover{transform:translateY(-1px);}
.pv2 .btn-dark{background:var(--navy); color:#fff;}
.pv2 .btn-dark:hover{background:var(--navy-3); box-shadow:var(--shadow-lift);}
.pv2 .btn-outline{background:transparent; border-color:var(--border); color:var(--ink);}
.pv2 .btn-outline:hover{border-color:var(--ink);}
.pv2 .btn-block{width:100%;}

/* ==================== HERO ==================== */
.pv2 .hero{padding:64px 0 80px;}
.pv2 .hero-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;}
.pv2 .hero h1{font-size:clamp(38px,4.8vw,54px);}
.pv2 .hero-lead{color:var(--ink-soft); font-size:18px; max-width:480px; margin:22px 0 30px;}
.pv2 .hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:36px;}
.pv2 .hero-actions .btn-outline{gap:6px;}
.pv2 .hero-stats{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; max-width:520px;}
.pv2 .stat-card{
  background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-md);
  padding:18px 16px; box-shadow:var(--shadow-card);
}
.pv2 .stat-value{font-family:'Montserrat',sans-serif; font-size:26px; font-weight:900;}
.pv2 .stat-label{font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); margin-top:4px;}

.pv2 .hero-art{position:relative; aspect-ratio:1/0.86; border-radius:32px; overflow:hidden;
  background:linear-gradient(160deg,var(--cream-soft),var(--cream));}
.pv2 .hero-art .blob{position:absolute; border-radius:50%;}
.pv2 .hero-art .blob-orange{width:230px; height:230px; top:-40px; right:-50px; background:rgba(232,130,47,0.55);}
.pv2 .hero-art .blob-navy{width:220px; height:220px; top:34%; left:8%; background:rgba(15,39,66,0.12);}
.pv2 .hero-art .blob-cream{width:260px; height:260px; bottom:-30px; left:22%; background:var(--paper);}
.pv2 .hero-art .emoji-cat{position:absolute; top:16%; right:22%; font-size:54px;}
.pv2 .hero-art .emoji-dog{position:absolute; bottom:14%; right:10%; font-size:60px;}
.pv2 .hero-art .emoji-bone{position:absolute; top:47%; left:34%; font-size:34px; transform:rotate(-18deg);}
.pv2 .hero-card-today{
  position:absolute; top:22px; left:22px; background:var(--paper); border-radius:var(--radius-md);
  padding:14px 16px; display:flex; align-items:center; gap:10px; box-shadow:var(--shadow-card);
  max-width:230px;
}
.pv2 .hero-card-today .icon{
  width:36px; height:36px; border-radius:50%; background:var(--orange-soft);
  display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;
}
.pv2 .hero-card-today .title{font-size:13.5px; font-weight:700;}
.pv2 .hero-card-today .sub{font-size:11.5px; color:var(--ink-faint); margin-top:2px;}
.pv2 .hero-card-testimonial{
  position:absolute; bottom:24px; right:24px; background:var(--navy); color:var(--cream-soft);
  border-radius:var(--radius-md); padding:18px 20px; max-width:260px; box-shadow:var(--shadow-lift);
}
.pv2 .hero-card-testimonial .label{font-size:10.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--orange); margin-bottom:8px;}
.pv2 .hero-card-testimonial .quote{font-size:14.5px; line-height:1.4; font-weight:500;}
.pv2 .hero-card-testimonial .author{font-size:11.5px; color:rgba(240,236,211,0.6); margin-top:10px;}

/* ==================== WAYS TO HELP ==================== */
.pv2 .ways{padding:70px 0 90px;}
.pv2 .ways-head{display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:40px;}
.pv2 .ways-head h2{font-size:clamp(28px,3.4vw,38px);}
.pv2 .filter-tabs{display:inline-flex; gap:4px; background:var(--paper); border:1px solid var(--border); border-radius:100px; padding:4px;}
.pv2 .filter-tab{
  padding:9px 18px; border-radius:100px; border:none; background:transparent; font-size:13.5px; font-weight:700;
  color:var(--ink-soft); transition:background .15s ease, color .15s ease;
}
.pv2 .filter-tab.active{background:var(--navy); color:#fff;}

.pv2 .cards3{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
.pv2 .way-card{
  background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:26px 24px; display:flex; flex-direction:column; box-shadow:var(--shadow-card);
  transition:opacity .2s ease, transform .2s ease;
}
.pv2 .way-card[hidden]{display:none;}
.pv2 .way-card-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:18px;}
.pv2 .way-icon{
  width:42px; height:42px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:19px;
}
.pv2 .way-icon.orange{background:var(--orange); color:#fff;}
.pv2 .way-icon.navy{background:var(--navy); color:#fff;}
.pv2 .way-tag{
  font-size:10.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
  background:var(--navy); color:#fff; padding:5px 11px; border-radius:100px;
}
.pv2 .way-card h3{font-size:17.5px; margin-bottom:10px;}
.pv2 .way-card-desc{font-size:14px; color:var(--ink-soft); margin-bottom:18px;}
.pv2 .way-section-label{
  font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint);
  margin-bottom:10px; margin-top:4px; display:flex; align-items:center; gap:6px;
}
.pv2 .way-list{list-style:none; margin-bottom:16px;}
.pv2 .way-list.check li{display:flex; gap:9px; align-items:flex-start; font-size:13.5px; margin-bottom:9px; color:var(--ink);}
.pv2 .way-list.check li::before{
  content:"✓"; flex-shrink:0; width:17px; height:17px; border-radius:50%; background:var(--orange-soft);
  color:var(--orange-2); font-size:10px; font-weight:900; display:flex; align-items:center; justify-content:center; margin-top:2px;
}
.pv2 .way-list.dot li{display:flex; gap:9px; align-items:flex-start; font-size:13px; margin-bottom:7px; color:var(--ink-soft);}
.pv2 .way-list.dot li::before{content:"•"; color:var(--ink-faint); flex-shrink:0;}
.pv2 .way-card-footer{
  margin-top:auto; padding-top:18px; border-top:1px solid var(--border);
  display:flex; align-items:flex-end; justify-content:space-between; gap:10px;
}
.pv2 .commit-label{font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:3px;}
.pv2 .commit-value{font-size:14px; font-weight:700; margin-bottom:3px;}
.pv2 .commit-desc{font-size:12px; color:var(--ink-faint); max-width:170px;}
.pv2 .way-card-footer .btn{padding:10px 18px; font-size:13.5px; flex-shrink:0;}

/* ==================== STEPS (dark) ==================== */
.pv2 .steps{
  background:radial-gradient(120% 140% at 85% 0%, var(--navy-2) 0%, var(--navy) 46%, var(--navy-3) 82%);
  border-radius:36px; color:var(--cream-soft); padding:56px 48px; margin:0 32px;
}
.pv2 .steps-inner{max-width:1180px; margin:0 auto;}
.pv2 .steps-head{display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap; margin-bottom:40px;}
.pv2 .steps-head h2{font-size:clamp(28px,3.4vw,38px); color:var(--cream-soft); margin-top:14px;}
.pv2 .steps .pill-light{background:rgba(255,255,255,0.08); border-color:rgba(255,255,255,0.16); color:rgba(240,236,211,0.8);}
.pv2 .steps-lead{color:rgba(240,236,211,0.65); font-size:16px; max-width:340px; align-self:flex-end;}
.pv2 .steps-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
.pv2 .step-card{background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:var(--radius-md); padding:22px 20px;}
.pv2 .step-num{font-family:'Montserrat',sans-serif; font-weight:900; font-size:26px; color:var(--orange); margin-bottom:16px;}
.pv2 .step-card h4{font-size:15.5px; margin-bottom:8px; color:var(--cream-soft);}
.pv2 .step-card p{font-size:13.5px; color:rgba(240,236,211,0.6); line-height:1.5;}

/* ==================== TRANSFORM ==================== */
.pv2 .transform{padding:90px 0;}
.pv2 .transform-grid{display:grid; grid-template-columns:0.85fr 1.15fr; gap:56px; align-items:start;}
.pv2 .transform h2{font-size:clamp(28px,3.4vw,38px); margin-bottom:18px;}
.pv2 .transform-lead{color:var(--ink-soft); font-size:16px; margin-bottom:26px;}
.pv2 .human-fact{
  background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-md);
  padding:18px 18px; display:flex; gap:14px; align-items:flex-start; box-shadow:var(--shadow-card);
}
.pv2 .human-fact .emoji{
  width:36px; height:36px; border-radius:50%; background:var(--orange-soft); flex-shrink:0;
  display:flex; align-items:center; justify-content:center; font-size:16px;
}
.pv2 .human-fact p{font-size:14px; color:var(--ink-soft); line-height:1.5;}
.pv2 .human-fact strong{color:var(--ink);}
.pv2 .transform-cards{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:20px;}
.pv2 .transform-card{background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-md); padding:22px 20px; box-shadow:var(--shadow-card);}
.pv2 .transform-card .emoji{font-size:22px; margin-bottom:14px;}
.pv2 .transform-card h4{font-size:15.5px; margin-bottom:8px;}
.pv2 .transform-card p{font-size:13.5px; color:var(--ink-soft); line-height:1.5;}
.pv2 .transform-note{
  background:var(--orange-soft); border:1px solid var(--orange-border); border-radius:var(--radius-md);
  padding:18px 20px; display:flex; gap:14px; align-items:flex-start;
}
.pv2 .transform-note .emoji{
  width:36px; height:36px; border-radius:50%; background:var(--paper); flex-shrink:0;
  display:flex; align-items:center; justify-content:center; font-size:16px;
}
.pv2 .transform-note p{font-size:14px; color:var(--ink-soft); line-height:1.5;}
.pv2 .transform-note strong{color:var(--ink);}

/* ==================== FAQ ==================== */
.pv2 .faq{padding:70px 0 90px;}
.pv2 .faq h2{text-align:center; font-size:clamp(28px,3.4vw,36px); margin-bottom:36px;}
.pv2 .faq-list{max-width:820px; margin:0 auto; background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-card);}
.pv2 .faq-item{border-bottom:1px solid var(--border);}
.pv2 .faq-item:last-child{border-bottom:none;}
.pv2 .faq-q{
  width:100%; background:none; border:none; text-align:left; padding:22px 26px;
  display:flex; align-items:center; justify-content:space-between; gap:16px;
}
.pv2 .faq-q h3{font-size:15.5px;}
.pv2 .faq-chevron{
  width:34px; height:34px; border-radius:50%; background:var(--navy); color:#fff; flex-shrink:0;
  display:flex; align-items:center; justify-content:center; transition:transform .25s ease; font-size:12px;
}
.pv2 .faq-item.open .faq-chevron{transform:rotate(180deg);}
.pv2 .faq-a{max-height:0; overflow:hidden; transition:max-height .3s ease, padding .3s ease;}
.pv2 .faq-item.open .faq-a{max-height:200px; padding:0 26px 24px;}
.pv2 .faq-a p{font-size:14.5px; color:var(--ink-soft); line-height:1.5; max-width:640px;}

/* ==================== CTA + FORM ==================== */
.pv2 .cta{padding:0 0 100px;}
.pv2 .cta-grid{display:grid; grid-template-columns:0.85fr 1.15fr; gap:24px;}
.pv2 .cta-panel{
  background:var(--cream-soft); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:40px 36px; display:flex; flex-direction:column;
}
.pv2 .cta-panel h2{font-size:clamp(28px,3.2vw,36px); margin:16px 0 16px;}
.pv2 .cta-lead{color:var(--ink-soft); font-size:15px; margin-bottom:22px;}
.pv2 .cta-checks{list-style:none; margin-bottom:26px;}
.pv2 .cta-checks li{display:flex; gap:10px; align-items:center; font-size:14px; margin-bottom:12px;}
.pv2 .cta-checks li::before{
  content:"✓"; width:20px; height:20px; border-radius:50%; background:var(--navy); color:#fff;
  font-size:10px; font-weight:900; display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.pv2 .social-proof{
  margin-top:auto; background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-md);
  padding:14px 16px; display:flex; align-items:center; gap:12px; font-size:13px; color:var(--ink-soft);
}
.pv2 .avatar-stack{display:flex; flex-shrink:0;}
.pv2 .avatar-stack span{
  width:30px; height:30px; border-radius:50%; background:var(--orange-soft); border:2px solid var(--cream-soft);
  display:flex; align-items:center; justify-content:center; font-size:14px; margin-left:-8px;
}
.pv2 .avatar-stack span:first-child{margin-left:0;}
.pv2 .avatar-stack .count{background:var(--navy); color:#fff; font-size:11px; font-weight:700;}

.pv2 .form-panel{
  background:var(--paper); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:36px 36px 30px; box-shadow:var(--shadow-lift);
}
.pv2 .form-panel-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;}
.pv2 .form-panel-head h3{font-size:19px;}
.pv2 .pill-time{background:var(--orange-soft); color:var(--orange-2); font-size:11.5px;}
.pv2 .form-row2{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
.pv2 .field{margin-bottom:18px;}
.pv2 .field label{
  display:block; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
  color:var(--ink-faint); margin-bottom:8px;
}
.pv2 .field input, .pv2 .field select, .pv2 .field textarea{
  width:100%; padding:13px 14px; border-radius:var(--radius-sm); border:1.5px solid var(--border);
  background:var(--cream-soft); font-family:'Montserrat',sans-serif; font-size:15px; color:var(--ink);
}
.pv2 .field textarea{min-height:110px; resize:vertical;}
.pv2 .field input:focus, .pv2 .field select:focus, .pv2 .field textarea:focus{outline:none; border-color:var(--orange);}
.pv2 .field input::placeholder, .pv2 .field textarea::placeholder{color:var(--ink-faint);}
.pv2 .form-actions{display:flex; gap:12px; margin-top:6px; flex-wrap:wrap;}
.pv2 .form-actions .btn-dark{flex:1;}
.pv2 .form-note{display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--ink-faint); margin-top:16px;}
.pv2 .form-error{
  display:none; background:var(--orange-soft); border:1px solid var(--orange-border); color:var(--orange-2);
  border-radius:var(--radius-sm); padding:12px 14px; font-size:13.5px; margin-top:14px;
}
.pv2 .form-error.show{display:block;}
.pv2 .form-success{
  display:none; background:var(--cream-soft); border:1px solid var(--border); color:var(--navy);
  border-radius:var(--radius-sm); padding:12px 14px; font-size:13.5px; margin-top:14px; font-weight:700;
}
.pv2 .form-success.show{display:block;}
.pv2 .checkline{
  display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; font-size:13px;
  color:var(--ink-soft); line-height:1.5;
}
.pv2 .checkline input[type="checkbox"]{
  width:18px; height:18px; margin-top:2px; flex-shrink:0; accent-color:var(--orange); cursor:pointer;
}
.pv2 .checkline a{color:var(--orange-2); font-weight:700; text-decoration:underline;}
.pv2 .checkline strong{color:var(--ink);}
.pv2 .required-note{font-size:12px; color:var(--ink-faint); margin:-4px 0 16px;}

/* ==================== RESPONSIVE ==================== */
@media (max-width:980px){
  .pv2 .hero-grid{grid-template-columns:1fr;}
  .pv2 .hero-art{order:-1; aspect-ratio:4/3;}
  .pv2 .cards3{grid-template-columns:1fr;}
  .pv2 .steps-grid{grid-template-columns:1fr 1fr;}
  .pv2 .steps{margin:0 16px; padding:44px 24px;}
  .pv2 .steps-head{flex-direction:column;}
  .pv2 .steps-lead{align-self:flex-start;}
  .pv2 .transform-grid{grid-template-columns:1fr;}
  .pv2 .transform-cards{grid-template-columns:1fr 1fr;}
  .pv2 .cta-grid{grid-template-columns:1fr;}
}
@media (max-width:640px){
  .pv2 .wrap{padding:0 20px;}
  .pv2 .hero-stats{grid-template-columns:1fr;}
  .pv2 .steps-grid{grid-template-columns:1fr;}
  .pv2 .transform-cards{grid-template-columns:1fr;}
  .pv2 .form-row2{grid-template-columns:1fr;}
  .pv2 .ways-head{flex-direction:column; align-items:flex-start;}
}
@media (prefers-reduced-motion: reduce){
